{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "Dark Glass 2.3",
    "owner": "ProfessorEngineer",
    "version": "2.3.0",
    "thesis": "A dark precision instrument that reveals light through intent.",
    "defaultTheme": "aurora"
  },
  "theme": {
    "aurora": {
      "$description": "Primary brand. A near-black optical field with a cyan-violet-magenta signal spectrum.",
      "canvas": { "$type": "color", "$value": "#05060A" },
      "surface": { "$type": "color", "$value": "#0A0E18" },
      "surfaceRaised": { "$type": "color", "$value": "#111827" },
      "text": { "$type": "color", "$value": "#F5F7FC" },
      "textMuted": { "$type": "color", "$value": "#9AA5B7" },
      "accent": { "$type": "color", "$value": "#5EE7FF" },
      "accentSecondary": { "$type": "color", "$value": "#8B7CFF" },
      "accentTertiary": { "$type": "color", "$value": "#FF6AD5" },
      "gradient": { "$type": "string", "$value": "linear-gradient(120deg, #5EE7FF, #8B7CFF 52%, #FF6AD5)" },
      "glassTintRgb": { "$type": "string", "$value": "8, 13, 24" }
    },
    "obsidian": {
      "$description": "Pure-black instrument mode. Restrained silver light, maximum focus and minimum chroma.",
      "canvas": { "$type": "color", "$value": "#000000" },
      "surface": { "$type": "color", "$value": "#09090A" },
      "surfaceRaised": { "$type": "color", "$value": "#131315" },
      "text": { "$type": "color", "$value": "#F4F4F2" },
      "textMuted": { "$type": "color", "$value": "#A0A0A0" },
      "accent": { "$type": "color", "$value": "#F4F4F2" },
      "accentSecondary": { "$type": "color", "$value": "#858589" },
      "accentTertiary": { "$type": "color", "$value": "#56565B" },
      "gradient": { "$type": "string", "$value": "linear-gradient(120deg, #FFFFFF, #A8A8AC 52%, #56565B)" },
      "glassTintRgb": { "$type": "string", "$value": "7, 7, 8" }
    },
    "lux": {
      "$description": "Warm luxury mode. Smoked glass, parchment light and clay accents; calm rather than nostalgic.",
      "canvas": { "$type": "color", "$value": "#17130F" },
      "surface": { "$type": "color", "$value": "#211A15" },
      "surfaceRaised": { "$type": "color", "$value": "#30241D" },
      "text": { "$type": "color", "$value": "#F5EEE5" },
      "textMuted": { "$type": "color", "$value": "#B9A99A" },
      "accent": { "$type": "color", "$value": "#EFB47F" },
      "accentSecondary": { "$type": "color", "$value": "#C87859" },
      "accentTertiary": { "$type": "color", "$value": "#DC9C89" },
      "gradient": { "$type": "string", "$value": "linear-gradient(120deg, #F2D2AD, #D58B68 52%, #A95D48)" },
      "glassTintRgb": { "$type": "string", "$value": "35, 25, 19" }
    }
  },
  "color": {
    "status": {
      "valid": { "$type": "color", "$value": "#5FF0BC" },
      "working": { "$type": "color", "$value": "#5EE7FF" },
      "warning": { "$type": "color", "$value": "#FFE2A6" },
      "danger": { "$type": "color", "$value": "#FF7085" }
    },
    "line": {
      "quiet": { "$type": "string", "$value": "rgba(255, 255, 255, 0.12)" },
      "strong": { "$type": "string", "$value": "rgba(255, 255, 255, 0.20)" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Space Grotesk" },
      "body": { "$type": "fontFamily", "$value": "Inter" },
      "data": { "$type": "fontFamily", "$value": "JetBrains Mono" },
      "future": { "$type": "fontFamily", "$value": "Exo 2" },
      "signature": { "$type": "fontFamily", "$value": "Nasalization" },
      "mission": { "$type": "fontFamily", "$value": "NotesESA" }
    },
    "usage": {
      "publicWebAlternative": { "$type": "fontFamily", "$value": "Exo 2" },
      "signatureLicense": { "$type": "string", "$value": "Local specimen only; obtain a web license before embedding Nasalization." },
      "missionLicense": { "$type": "string", "$value": "Local specimen only; verify NotesESA web embedding rights before distribution." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "$description": "Core geometry for 80–90% of the interface.",
    "control": { "$type": "dimension", "$value": "8px" },
    "compact": { "$type": "dimension", "$value": "12px" },
    "surface": { "$type": "dimension", "$value": "18px" },
    "feature": { "$type": "dimension", "$value": "28px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shape": {
    "$description": "Named Material 3 Expressive geometry for 10–20% of the interface. Use normalized SVG symbols; never synthesize percentage-radius blobs.",
    "coreShare": { "$type": "number", "$value": 0.85 },
    "expressiveShare": { "$type": "number", "$value": 0.15 },
    "square": { "$type": "string", "$value": "MaterialShapes.Square | #shape-square" },
    "pill": { "$type": "string", "$value": "MaterialShapes.Pill | #shape-pill" },
    "arch": { "$type": "string", "$value": "MaterialShapes.Arch | #shape-arch" },
    "diamond": { "$type": "string", "$value": "MaterialShapes.Diamond | #shape-diamond" },
    "cookie4": { "$type": "string", "$value": "MaterialShapes.Cookie4Sided | #shape-cookie" },
    "softBurst": { "$type": "string", "$value": "MaterialShapes.SoftBurst | #shape-softburst" }
  },
  "glyph": {
    "$description": "Original Dark Glass 24px orbital glyphs. Rounded open strokes, 1.65–1.8px, no filled decoration.",
    "grid": { "$type": "dimension", "$value": "24px" },
    "stroke": { "$type": "dimension", "$value": "1.65px" },
    "set": { "$type": "string", "$value": "orbit-arrow, fold-arrow, thrust, phase-rails, aperture, waypoint, transfer, telemetry, scan, constellation, dock, split, pulse, axis, portal, relay" }
  },
  "material": {
    "$description": "Optical depth tokens. Glass must reveal real content behind the plane.",
    "air": {
      "fill": { "$type": "number", "$value": 0 },
      "blur": { "$type": "dimension", "$value": "0px" }
    },
    "quiet": {
      "fill": { "$type": "number", "$value": 0.055 },
      "blur": { "$type": "dimension", "$value": "16px" }
    },
    "base": {
      "fill": { "$type": "number", "$value": 0.075 },
      "blur": { "$type": "dimension", "$value": "24px" }
    },
    "raised": {
      "fill": { "$type": "number", "$value": 0.095 },
      "blur": { "$type": "dimension", "$value": "32px" }
    },
    "focus": {
      "fill": { "$type": "number", "$value": 0.115 },
      "blur": { "$type": "dimension", "$value": "40px" }
    },
    "liquid": {
      "fill": { "$type": "number", "$value": 0.095 },
      "blur": { "$type": "dimension", "$value": "28px" },
      "saturation": { "$type": "number", "$value": 1.65 },
      "contrast": { "$type": "number", "$value": 1.08 },
      "brightness": { "$type": "number", "$value": 1.04 },
      "refraction": { "$type": "number", "$value": 0.62 },
      "edgeLight": { "$type": "number", "$value": 0.2 }
    }
  },
  "interaction": {
    "hoverLift": { "$type": "dimension", "$value": "0px" },
    "hoverScale": { "$type": "number", "$value": 1 },
    "pressScale": { "$type": "number", "$value": 0.985 },
    "magneticMaximum": { "$type": "dimension", "$value": "0px" },
    "pointerExitReset": { "$type": "boolean", "$value": true },
    "hoverLaw": { "$type": "string", "$value": "Change local edge light, gradient and shadow only; content and silhouette never move." },
    "buttonLensRadius": { "$type": "dimension", "$value": "90px" },
    "surfaceLensRadius": { "$type": "dimension", "$value": "180px" }
  },
  "dimensionality": {
    "$description": "Add depth without changing silhouette or position.",
    "1-plane": { "$type": "string", "$value": "material fill + 1px border" },
    "2-topLight": { "$type": "string", "$value": "plane + bright inset top edge" },
    "3-perimeter": { "$type": "string", "$value": "top light + side inset lights + dark lower seam" },
    "4-liveOptic": { "$type": "string", "$value": "perimeter + pointer-local edge lens" }
  },
  "waveSlider": {
    "$description": "Native range input over a generated, value-reactive signal rail.",
    "defaultSegments": { "$type": "number", "$value": 30 },
    "denseSegments": { "$type": "number", "$value": 38 },
    "amplitude": { "$type": "dimension", "$value": "7px" },
    "progressSource": { "$type": "string", "$value": "native input[type=range]" }
  },
  "motion": {
    "instant": { "$type": "duration", "$value": "90ms" },
    "control": { "$type": "duration", "$value": "160ms" },
    "shift": { "$type": "duration", "$value": "280ms" },
    "reveal": { "$type": "duration", "$value": "420ms" },
    "atmosphere": { "$type": "duration", "$value": "700ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
  },
  "size": {
    "targetMinimum": { "$type": "dimension", "$value": "44px" },
    "contentMaximum": { "$type": "dimension", "$value": "1280px" }
  }
}
